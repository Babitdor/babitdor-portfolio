# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
# dev server output captured for inspection
dev.log
*.log

# env files (can opt-in for committing if needed)
.env*

# Source images for the ASCII portrait.
#
# Deliberately NOT published: the site shows the generated art, not the source.
# The generated output (public/ascii-portrait.png) IS committed, so the build does
# not need these; they are only inputs to `scripts/ascii-portrait.ps1`, which you
# run by hand after changing an image.
#
# ASCII.png is the current source: a raster ASCII-art render, 8.5 MB. Me.jpg is
# the earlier photograph, kept for provenance.
/Me.jpg
/ASCII.png

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
